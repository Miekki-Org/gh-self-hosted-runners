    "version": "0.2.0",
    "configurations": [
        {
            "name": "RunnerControlPlane",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build RunnerControlPlane",
            "program": "${workspaceFolder}/src/RunnerControlPlane/bin/Debug/net10.0/RunnerControlPlane.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/RunnerControlPlane",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "RunnerImageManifestResolver (offline fixture)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build RunnerImageManifestResolver",
            "program": "${workspaceFolder}/src/RunnerImageManifestResolver/bin/Debug/net10.0/RunnerImageManifestResolver.dll",
            "args": [
                "--manifest",
                "${workspaceFolder}/tests/RunnerControlPlane.Tests/Fixtures/RunnerImageResolver/manifest.json",
                "--metadata-dir",
                "${workspaceFolder}/tests/RunnerControlPlane.Tests/Fixtures/RunnerImageResolver/metadata"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}