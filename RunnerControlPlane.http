@baseUrl = https://localhost:7142
@accessToken = {{$processEnv ACCESS_TOKEN}}

# Set ACCESS_TOKEN to an Entra bearer token accepted by the control plane.
# Configure AzureVmScaleSet before enabling live VM Scale Set changes. Image build integrations remain unconfigured.

### Read runner-group access
GET {{baseUrl}}/api/runner-access
Authorization: Bearer {{accessToken}}
Accept: application/json

### List runner images
GET {{baseUrl}}/api/runner-images
Authorization: Bearer {{accessToken}}
Accept: application/json

### List validated images available for production runners
GET {{baseUrl}}/api/runner-images/available
Authorization: Bearer {{accessToken}}
Accept: application/json

### List runner VMs
GET {{baseUrl}}/api/runner-vms
Authorization: Bearer {{accessToken}}
Accept: application/json

### View runner capacity and queued demand
GET {{baseUrl}}/api/runner-capacity
Authorization: Bearer {{accessToken}}
Accept: application/json

### View capacity change audit records
GET {{baseUrl}}/api/runner-capacity/audit
Authorization: Bearer {{accessToken}}
Accept: application/json

### Update capacity settings (operators only)
PUT {{baseUrl}}/api/runner-capacity/settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "minimumCapacity": 0,
  "maximumCapacity": 10
}

### Request one-off scale-out (operators only; capped at maximum)
POST {{baseUrl}}/api/runner-capacity/scale-out
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "count": 2
}

### Request an expedited image build
# Replace these sample pins with versions approved for your repositories.
# @name buildImage
POST {{baseUrl}}/api/runner-images
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "ubuntuRelease": "24.04",
  "dotNetSdks": ["8.0.404"],
  "packages": {
    "curl": "8.5.0"
  },
  "runnerVersion": "2.331.0",
  "expedited": true
}

### Inspect the build requested above
GET {{baseUrl}}/api/runner-images/{{buildImage.response.body.$.version}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Start a canary rollout for the validated image (operators only)
# The image must appear in GET /api/runner-images/available.
# The rollout record reports its stage, deployed version, failure reason, and audit trail.
# @name startImageRollout
POST {{baseUrl}}/api/runner-images/rollouts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "imageVersion": "{{buildImage.response.body.$.version}}"
}

### List image rollouts
GET {{baseUrl}}/api/runner-images/rollouts
Authorization: Bearer {{accessToken}}
Accept: application/json

### Inspect the rollout requested above
GET {{baseUrl}}/api/runner-images/rollouts/{{startImageRollout.response.body.$.id}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Mark the canary successful and promote the image to the remaining pool (operators only)
# Use this only after external canary health checks pass.
POST {{baseUrl}}/api/runner-images/rollouts/{{startImageRollout.response.body.$.id}}/canary/success
Authorization: Bearer {{accessToken}}
Accept: application/json

### Mark the canary failed and roll back (operators only)
# Use instead of the success action when canary validation fails.
POST {{baseUrl}}/api/runner-images/rollouts/{{startImageRollout.response.body.$.id}}/canary/failure
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "failureReason": "Canary health check failed."
}

### Request one Runner VM
# Set imageVersion to a validated image version from GET /api/runner-images/available.
# The request is available to operators only.
# @name createRunnerVm
POST {{baseUrl}}/api/runner-vms
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "imageVersion": "24.04"
}

### Inspect the runner VM requested above
GET {{baseUrl}}/api/runner-vms/{{createRunnerVm.response.body.$.id}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Update runner VM status and outcome
PATCH {{baseUrl}}/api/runner-vms/{{createRunnerVm.response.body.$.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "Finished",
  "outcome": "Success",
  "error": null,
  "retryScheduled": false,
  "isRetired": false
}

### Update only the runner VM status
PATCH {{baseUrl}}/api/runner-vms/{{createRunnerVm.response.body.$.id}}/status?status=Working
Authorization: Bearer {{accessToken}}
Accept: application/json

### Retire a runner VM
POST {{baseUrl}}/api/runner-vms/{{createRunnerVm.response.body.$.id}}/retire?outcome=Success
Authorization: Bearer {{accessToken}}
Accept: application/json

